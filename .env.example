# Copy to .env for local dev; on the server these are set in the Portainer stack
# env, never in a committed file. No real secret values ever go in git.

PORT=3014
SESSION_SECRET=change-me

# Auth (login is optional — public recipes need no session)
AUTH_SERVICE_URL=http://octopus-auth:3002
AUTH_PUBLIC_URL=https://auth.octopustechnology.net

# Same app, two domains (games pattern)
PUBLIC_HOST=food.octopustechnology.net
APP_HOST=kitchen.octopustechnology.net

# Ownership / service integration
ADMIN_USERNAME=
SERVICE_DEFAULT_OWNER=
KITCHEN_SERVICE_TOKEN=

# Price checking is delegated to octopus-shopper (it holds the store API keys)
SHOPPER_URL=http://octopus_shopper_internal:3004
SHOPPER_SERVICE_TOKEN=

# Amazon Associate tag for affiliate links on public recipe pages (public, not
# a secret — it rides in every affiliate URL). US tags end in -20.
PUBLIC_AMAZON_ASSOCIATE_TAG=

DB_PATH=./data/kitchen.db
